@using PavlovVR_Rcon.Models.Pavlov;
@using PterodactylPavlovServerController.Models;
@using PterodactylPavlovServerController.Services;
@inject PavlovRconService RconService
@inject IToastService Toast
@inject ApiKeyService ApiKey
@inject AuditService AuditService

<div class="me-2" style="width: 425px; display: inline-block; vertical-align: top;">
    <h3 class="mb-0">Server mods</h3>
    <small class="text-muted">
        Adds or removes mod.io mods on the server. Mods are applied on the next map load.
    </small>

    <EditForm Model="@ugcMod" OnValidSubmit="@addSubmitted" class="mt-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Mod ID</label>
            <InputNumber @bind-Value="ugcMod.ModId" class="form-control" />
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-outline-success form-control">Add mod</button>
        </div>
        <div class="mb-3">
            <button type="button" class="btn btn-outline-danger form-control" @onclick="removeSubmitted">Remove mod</button>
        </div>
    </EditForm>

    <div class="mb-3">
        <button type="button" class="btn btn-outline-secondary form-control" @onclick="refreshModList">Refresh mod list</button>
    </div>

    @if (modList != null)
    {
        <div class="mb-3">
            @if (modList.Length == 0)
            {
                <span class="text-muted">No mods on the server.</span>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (string mod in modList)
                    {
                        <li>@mod</li>
                    }
                </ul>
            }
        </div>
    }

    <div class="mb-3">
        <ConfirmDialog @ref="clearConfirm" ConfirmationChanged="confirmClear" ConfirmationTitle="Remove all mods?" ConfirmationMessage="Do you really want to remove every mod from this server?" ConfirmButtonText="Remove all" Id="@($"clear-mods-{Connection.ServerId}")" />
        <a class="btn btn-outline-danger form-control" href="#" data-bs-toggle="modal" data-bs-target="#clear-mods-@Connection.ServerId">Clear mod list</a>
    </div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public PavlovRconConnection Connection { get; set; }

    [Parameter]
    [EditorRequired]
    public ServerInfo ServerInfo { get; set; }

    private readonly UGCModModel ugcMod = new();
    private string[]? modList = null;
    private ConfirmDialog clearConfirm { get; set; } = null!;

    private async Task addSubmitted()
    {
        if (ugcMod.ModId == null)
        {
            Toast.ShowError("You need to enter a mod ID");
            return;
        }

        try
        {
            if (!await RconService.UGCAddMod(ApiKey.ApiKey, Connection.ServerId, ugcMod.ModId!.Value))
            {
                Toast.ShowError("Server refused the command");
                return;
            }

            Toast.ShowSuccess("Mod has been added");
            await AuditService.Add(Connection.ServerId, $"Added mod {ugcMod.ModId!.Value}");
            await refreshModList();
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
        }
    }

    private async Task removeSubmitted()
    {
        if (ugcMod.ModId == null)
        {
            Toast.ShowError("You need to enter a mod ID");
            return;
        }

        try
        {
            if (!await RconService.UGCRemoveMod(ApiKey.ApiKey, Connection.ServerId, ugcMod.ModId!.Value))
            {
                Toast.ShowError("Server refused the command");
                return;
            }

            Toast.ShowSuccess("Mod has been removed");
            await AuditService.Add(Connection.ServerId, $"Removed mod {ugcMod.ModId!.Value}");
            await refreshModList();
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
        }
    }

    private async Task refreshModList()
    {
        try
        {
            modList = await RconService.UGCModList(ApiKey.ApiKey, Connection.ServerId);
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
        }
    }

    private async Task confirmClear(bool confirmed)
    {
        if (!confirmed)
        {
            return;
        }

        try
        {
            if (!await RconService.UGCClearModList(ApiKey.ApiKey, Connection.ServerId))
            {
                Toast.ShowError("Server refused the command");
                return;
            }

            Toast.ShowSuccess("Mod list has been cleared");
            await AuditService.Add(Connection.ServerId, "Cleared the server mod list");
            await refreshModList();
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
        }
    }
}
