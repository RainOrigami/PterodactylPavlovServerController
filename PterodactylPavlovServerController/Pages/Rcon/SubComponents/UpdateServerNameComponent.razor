@using PavlovVR_Rcon.Models.Pavlov;
@using PterodactylPavlovServerController.Models;
@using PterodactylPavlovServerController.Services;
@inject PavlovRconService RconService
@inject IToastService Toast
@inject ApiKeyService ApiKey
@inject AuditService AuditService

<div class="me-2" style="width: 425px; display: inline-block; vertical-align: top;">
    <h3 class="mb-0">Server name</h3>
    <small class="text-muted">
        Changes the server name. This does not persist across a server restart.
    </small>
    <EditForm Model="@serverName" OnValidSubmit="@serverNameSubmitted" class="mt-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Name</label>
            <InputText @bind-Value="serverName.Value" class="form-control" />
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-outline-success form-control">Update name</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public PavlovRconConnection Connection { get; set; }

    [Parameter]
    [EditorRequired]
    public ServerInfo ServerInfo { get; set; }

    private readonly GenericTextModel serverName = new();

    private async Task serverNameSubmitted()
    {
        if (string.IsNullOrWhiteSpace(serverName.Value))
        {
            Toast.ShowError("You need to enter a server name");
            return;
        }

        try
        {
            if (!await RconService.UpdateServerName(ApiKey.ApiKey, Connection.ServerId, serverName.Value))
            {
                Toast.ShowError("Server refused the command");
                return;
            }

            Toast.ShowSuccess("Server name has been updated");
            await AuditService.Add(Connection.ServerId, $"Updated server name to {serverName.Value}");
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
        }
    }
}
