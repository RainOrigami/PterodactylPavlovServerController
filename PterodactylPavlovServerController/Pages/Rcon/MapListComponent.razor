@using Fluxor;
@using PavlovVR_Rcon.Models.Pavlov;
@using PterodactylPavlovServerController.Models;
@using PterodactylPavlovServerController.Services;
@using PterodactylPavlovServerController.Stores;
@using PterodactylPavlovServerDomain.Models;
@using PterodactylPavlovServerController.Pages.Shared;
@using Microsoft.JSInterop;
@inject IDispatcher Dispatcher
@inject IState<MapsState> MapsState
@inject PavlovRconService RconService
@inject IToastService Toast
@inject ApiKeyService ApiKey
@inject IMapSourceService MapSourceService
@inject AuditService AuditService
@inject IJSRuntime JS

<div class="tab-pane container active px-0" id="maps">
    @* A map change boots everyone into a loading screen, and the whole tab is a
       grid of click targets - too easy to hit one by accident. *@
    <ConfirmDialog Id="@mapChangeConfirmId"
                   ConfirmationTitle="Change the map?"
                   ConfirmationMessage="@mapChangeConfirmMessage"
                   ConfirmButtonText="Change map"
                   ConfirmButtonClass="btn-warning"
                   ConfirmationChanged="confirmMapChange" />

    <h3>Click a map to change to</h3>
    @if (!MapsState.Value.ServerMaps.ContainsKey(Connection.ServerId))
    {
        @:Loading...
    }
    else
    {
        <a href="#" class="btn btn-outline-primary mb-3" data-bs-toggle="modal" data-bs-target="@mapChangeConfirmTarget" @onclick="@requestNextMap" @onclick:preventDefault>Next map</a>
        <br />

        foreach (ServerMapModel mapRow in MapsState.Value.ServerMaps[Connection.ServerId])
        {
            MapWorkshopModel? mapRowDetail = null;
            if (mapRow.IsWorkshopMap)
            {
                MapsState.Value.MapDetails.TryGetValue(mapRow.WorkshopId, out mapRowDetail);
            }

            <div class="card bg-dark me-2 mb-2" style="display: inline-block; width: 256px;@(ServerInfo.MapLabel.ToLower() == mapRow.MapLabel.ToLower() ? " background-color: #7D7 !important; color: #444;" : "")">
                <a href="#" @onclick="() => requestMapChange(mapRow)" @onclick:preventDefault data-bs-toggle="modal" data-bs-target="@mapChangeConfirmTarget" class="text-decoration-none">
                    <MapImage MapDetail="@mapRowDetail" Alt="@mapRow.MapLabel" />
                </a>
                <div class="card-body">
                    <a href="#" @onclick="() => requestMapChange(mapRow)" @onclick:preventDefault data-bs-toggle="modal" data-bs-target="@mapChangeConfirmTarget" class="text-decoration-none">
                        <h5 class="card-title">@(mapRowDetail is null or { Unavailable: true, } ? mapRow.MapLabel : mapRowDetail.Name)</h5>
                    </a>
                    <p class="card-text">
                        <div class="container px-0">
                            <div class="row gx-0">
                                <div class="col-auto px-1">
                                    <b>GameMode:</b>
                                </div>
                                <div class="col text-end px-1">@mapRow.GameMode</div>
                            </div>
                            @if (mapRow.IsWorkshopMap)
                            {
                                <div class="row gx-0">
                                    <div class="col-auto px-1">
                                        <b>Workshop:</b>
                                    </div>
                                    <div class="col text-end px-1">
                                        @if (mapRowDetail is { Unavailable: false, } && !string.IsNullOrEmpty(mapRow.Url))
                                        {
                                            <a href="@mapRow.Url" target="_blank">Open page</a>
                                        }
                                        else if (mapRowDetail is { Unavailable: true, })
                                        {
                                            <span class="text-warning">Delisted</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Loading...</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (mapRowDetail is { Unavailable: true, })
                            {
                                <div class="row gx-0">
                                    <div class="col px-1 text-warning" style="font-size: 0.85em;">
                                        Not on mod.io anymore - players without it cached cannot join.
                                    </div>
                                </div>
                            }
                            else if (mapRowDetail == null && mapRow.IsWorkshopMap)
                            {
                                <div class="row gx-0">
                                    <div class="col-auto px-1">Loading...</div>
                                </div>
                            }
                        </div>
                    </p>
                </div>
            </div>
        }
    }

    <h3 class="mt-3">Enter a map ID</h3>
    <EditForm Model="@mapChangeInput" OnValidSubmit="@requestFormMapChange">
        <DataAnnotationsValidator />
        <div class="container mb-5">
            <div class="row">
                <ValidationSummary />
            </div>
            <div class="row">
                <div class="col ps-0">
                    <InputText @bind-Value="mapChangeInput.Map" class="form-control" placeholder="Map ID" />
                </div>
                <div class="col">
                    <InputSelect @bind-Value="mapChangeInput.GameMode" class="form-select">
                        <option selected disabled>Select a game mode</option>
                        @foreach (GameMode gameMode in Enum.GetValues(typeof(GameMode)))
                        {
                            <option value="@gameMode">@gameMode</option>
                        }
                    </InputSelect>
                </div>
                <div class="col">
                    <button type="submit" class="btn btn-outline-primary">Change map</button>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-outline-success" @onclick="addToRotation">Add to rotation</button>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-outline-danger" @onclick="removeFromRotation">Remove from rotation</button>
                </div>

            </div>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public PavlovRconConnection Connection { get; set; }

    [Parameter]
    [EditorRequired]
    public ServerInfo ServerInfo { get; set; }

    private async Task addToRotation()
    {
        await changeRotation(true);
    }

    private async Task removeFromRotation()
    {
        await changeRotation(false);
    }

    private async Task changeRotation(bool add)
    {
        if (string.IsNullOrWhiteSpace(mapChangeInput.Map) || mapChangeInput.GameMode == null)
        {
            Toast.ShowError("You need to enter a map ID and select a game mode");
            return;
        }

        try
        {
            GameMode gameMode = mapChangeInput.GameMode!.Value;
            string mapLabel = mapChangeInput.MapLabel!;
            bool successful = add
                ? await RconService.AddMapRotation(ApiKey.ApiKey, Connection.ServerId, mapLabel, gameMode)
                : await RconService.RemoveMapRotation(ApiKey.ApiKey, Connection.ServerId, mapLabel, gameMode);

            if (!successful)
            {
                Toast.ShowError($"Server refused to {(add ? "add the map to" : "remove the map from")} the rotation");
                return;
            }

            Toast.ShowSuccess($"Map {mapLabel} ({gameMode}) has been {(add ? "added to" : "removed from")} the rotation");
            await AuditService.Add(Connection.ServerId, $"{(add ? "Added" : "Removed")} map {mapLabel} game mode {gameMode} {(add ? "to" : "from")} the rotation");
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
        }
    }

    private void requestMapChange(ServerMapModel serverMap)
    {
        MapWorkshopModel? mapDetail = null;
        if (serverMap.IsWorkshopMap)
        {
            MapsState.Value.MapDetails.TryGetValue(serverMap.WorkshopId, out mapDetail);
        }

        string mapName = mapDetail is null or { Unavailable: true, } ? serverMap.MapLabel : mapDetail.Name;

        this.pendingMapChange = new PendingMapChange(
            $"Change the map to {mapName} ({serverMap.GameMode})? Everyone on the server will be sent to the loading screen.",
            () => this.changeMap(serverMap));
    }

    private void requestNextMap()
    {
        this.pendingMapChange = new PendingMapChange(
            "Skip to the next map in the rotation? Everyone on the server will be sent to the loading screen.",
            this.nextMap);
    }

    private async Task confirmMapChange(bool confirmed)
    {
        PendingMapChange? request = this.pendingMapChange;
        this.pendingMapChange = null;

        if (!confirmed || request == null)
        {
            return;
        }

        await request.Execute();
    }

    private async Task changeMap(ServerMapModel serverMap)
    {
        MapWorkshopModel? mapDetail = null;
        if (serverMap.IsWorkshopMap)
        {
            MapsState.Value.MapDetails.TryGetValue(serverMap.WorkshopId, out mapDetail);
        }

        try
        {
            GameMode gameMode = Enum.Parse<GameMode>(serverMap.GameMode);
            if (await RconService.SwitchMap(ApiKey.ApiKey, Connection.ServerId, serverMap.MapLabel, gameMode))
            {
                Toast.ShowSuccess($"Map switching to {(mapDetail == null ? serverMap.MapLabel : mapDetail.Name)} ({serverMap.GameMode})");
                await AuditService.Add(Connection.ServerId, $"Changed map from {ServerInfo.MapLabel} to {serverMap.MapLabel} game mode {serverMap.GameMode}");
            }
            else
            {
                Toast.ShowError("Server refuses to switch map");
            }
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
            return;
        }
    }

    private readonly MapChangeInputModel mapChangeInput = new();

    private sealed record PendingMapChange(string Message, Func<Task> Execute);

    private PendingMapChange? pendingMapChange;

    private string mapChangeConfirmId => $"mapchange-{Connection.ServerId}";

    private string mapChangeConfirmTarget => $"#{this.mapChangeConfirmId}";

    private string mapChangeConfirmMessage => this.pendingMapChange?.Message ?? "Everyone on the server will be sent to the loading screen.";

    private async Task requestFormMapChange()
    {
        if (mapChangeInput.MapLabel == null || mapChangeInput.GameMode == null)
        {
            Toast.ShowError("Map label and game mode are required for a map change");
            return;
        }

        this.pendingMapChange = new PendingMapChange(
            $"Change the map to {mapChangeInput.MapLabel} ({mapChangeInput.GameMode})? Everyone on the server will be sent to the loading screen.",
            this.mapChange);

        // The card grid opens this modal with data-bs-toggle, but the form only
        // knows whether to ask once it has validated, so it opens it by hand.
        if (!await JS.InvokeAsync<bool>("ppscUi.showModal", this.mapChangeConfirmId))
        {
            // No modal to show means no way to confirm; do not silently drop the
            // map change the operator asked for.
            this.pendingMapChange = null;
            await this.mapChange();
        }
    }

    private async Task mapChange()
    {
        if (mapChangeInput.MapLabel == null || mapChangeInput.GameMode == null)
        {
            Toast.ShowError("Map label and game mode are required for a map change");
            return;
        }

        try
        {
            if (await RconService.SwitchMap(ApiKey.ApiKey, Connection.ServerId, mapChangeInput.MapLabel, mapChangeInput.GameMode.Value))
            {
                string mapName = mapChangeInput.MapLabel;
                if (mapChangeInput.IsCustomMap)
                {
                    mapName = MapSourceService.GetMapDetail(mapChangeInput.MapId!.Value).Name;
                }

                Toast.ShowSuccess($"Changing map to {mapName}");
                await AuditService.Add(Connection.ServerId, $"Changed map from {ServerInfo.MapLabel} to {mapChangeInput.MapLabel} game mode {mapChangeInput.GameMode.Value}");
            }
            else
            {
                Toast.ShowError("Server refused to switch map");
            }
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
            return;
        }
    }

    private async Task nextMap()
    {
        try
        {
            await RconService.RotateMap(ApiKey.ApiKey, Connection.ServerId);
            Toast.ShowSuccess("Map has been skipped");
            await AuditService.Add(Connection.ServerId, $"Rotated map from {ServerInfo.MapLabel}");
        }
        catch (Exception e)
        {
            Toast.ShowError(e.Message);
            return;
        }
    }
}
